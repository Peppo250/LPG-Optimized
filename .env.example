# LPG Catering Intelligence System - Environment Configuration Example
# Copy this file to '.env' and edit the values as needed.

# ── API Server Settings ──────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
RELOAD=true
ENVIRONMENT=development

# ── CORS Security ───────────────────────────────────────────────
# Comma-separated list of allowed origins. Use '*' to allow all.
ALLOWED_ORIGINS=*

# ── Pricing Configuration ───────────────────────────────────────
# Default price (INR) for standard 19-kg commercial cylinder
# (April 2024 IOC Chennai reference rate)
CYLINDER_PRICE_INR=1910
